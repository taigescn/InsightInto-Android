<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 用于上传数据，[事件数据上传] -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--  用于获取定位信息，[定位] -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--  用于获附近 WiFi 热点，[WiFi、定位] -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--  用于获取网络信息信息，[网络、WiFi、定位] -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--  用于获取 Google AdId，[AdId] -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!--  Google adid SDK: com.google.android.gms.ads_identifier、com.google.android.gms.common  -->
    <uses-sdk tools:overrideLibrary="com.google.android.gms.ads_identifier、com.google.android.gms.common" />

    <application
        android:name="com.taiges.insight.into.app.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InsightInto"
        android:usesCleartextTraffic="true"
        tools:replace="android:dataExtractionRules,android:fullBackupContent"
        tools:targetApi="31">

        <activity
            android:name="com.taiges.insight.into.app.ui.activity.EventActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.taiges.insight.into.app.ui.activity.WebViewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>