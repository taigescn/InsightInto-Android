<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <TextView
        android:id="@+id/user_id_tv"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="UserId"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/user_id_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:hint="请输入 UserId"
        android:maxLines="1"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/user_id_tv"
        app:layout_constraintEnd_toStartOf="@+id/setting_user_id_btn"
        app:layout_constraintStart_toEndOf="@+id/user_id_tv"
        app:layout_constraintTop_toTopOf="@+id/user_id_tv" />

    <Button
        android:id="@+id/setting_user_id_btn"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:text="设置"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/user_id_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/user_id_tv" />

    <TextView
        android:id="@+id/unique_id_tv"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="UniqueId"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_id_tv" />

    <EditText
        android:id="@+id/unique_id_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:hint="请输入 UniqueId"
        android:maxLines="2"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/unique_id_tv"
        app:layout_constraintEnd_toStartOf="@+id/setting_user_id_btn"
        app:layout_constraintStart_toEndOf="@+id/unique_id_tv"
        app:layout_constraintTop_toTopOf="@+id/unique_id_tv" />

    <Button
        android:id="@+id/setting_unique_id_btn"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:text="设置"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/unique_id_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/unique_id_tv" />

    <TextView
        android:id="@+id/phone_number_tv"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="PhoneNumber"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unique_id_tv" />

    <EditText
        android:id="@+id/phone_number_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:hint="请输入 UniqueId"
        android:maxLines="2"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/phone_number_tv"
        app:layout_constraintEnd_toStartOf="@+id/setting_user_id_btn"
        app:layout_constraintStart_toEndOf="@+id/phone_number_tv"
        app:layout_constraintTop_toTopOf="@+id/phone_number_tv" />

    <Button
        android:id="@+id/setting_phone_number_btn"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:text="设置"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/phone_number_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/phone_number_tv" />

    <TextView
        android:id="@+id/event_tv"
        android:layout_width="55dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="事件"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_number_tv" />

    <EditText
        android:id="@+id/event_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:hint="请输入事件编码(ecode)"
        android:maxLines="1"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/event_tv"
        app:layout_constraintEnd_toStartOf="@+id/send_event_btn"
        app:layout_constraintStart_toEndOf="@+id/event_tv"
        app:layout_constraintTop_toTopOf="@+id/event_tv" />

    <Button
        android:id="@+id/send_event_btn"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginEnd="15dp"
        android:text="触发事件"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/event_tv"
        app:layout_constraintEnd_toStartOf="@id/forward_h5_btn"
        app:layout_constraintTop_toTopOf="@+id/event_tv" />

    <Button
        android:id="@+id/forward_h5_btn"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:text="跳转 H5"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/event_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/event_tv" />

    <CheckBox
        android:id="@+id/privacy_policy_cb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        android:paddingStart="10dp"
        android:text="我已阅读并同意《隐私政策》和《用户服务协议》"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/send_event_btn"
        app:layout_constraintStart_toStartOf="@+id/event_tv"
        app:layout_constraintTop_toBottomOf="@+id/event_tv" />

    <TextView
        android:id="@+id/event_properties_tv"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="事件属性"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/privacy_policy_cb" />

    <Button
        android:id="@+id/request_permission_btn"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:text="申请权限"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/event_properties_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/event_properties_tv" />

    <Button
        android:id="@+id/event_properties_add_btn"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginEnd="10dp"
        android:text="新增"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/event_properties_tv"
        app:layout_constraintEnd_toStartOf="@+id/request_permission_btn"
        app:layout_constraintTop_toTopOf="@+id/event_properties_tv" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/event_properties_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/event_properties_tv" />

    <TextView
        android:id="@+id/session_properties_tv"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="会话属性"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/event_properties_recycler_view" />

    <Button
        android:id="@+id/session_properties_add_btn"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:text="新增"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/session_properties_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/session_properties_tv" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/session_properties_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@+id/session_properties_tv" />


</androidx.constraintlayout.widget.ConstraintLayout>