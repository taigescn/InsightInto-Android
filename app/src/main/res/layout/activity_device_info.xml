<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <TextView
        android:id="@+id/adid_tv"
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Adid:"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/adid_value_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/adid_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/adid_tv"
        app:layout_constraintTop_toTopOf="@+id/adid_tv" />

    <TextView
        android:id="@+id/is_limit_ad_tracking_enabled_tv"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="LimitAdTracking:"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adid_tv" />

    <TextView
        android:id="@+id/is_limit_ad_tracking_enabled_value_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/text_black_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/is_limit_ad_tracking_enabled_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/is_limit_ad_tracking_enabled_tv"
        app:layout_constraintTop_toTopOf="@+id/is_limit_ad_tracking_enabled_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>
